        "def run_pytest(target: str):\n",
        "    cmd = [sys.executable, \"-m\", \"pytest\", target, \"-v\"]\n",
        "    print(\"실행 명령:\", \" \".join(cmd))\n",
        "    result = subprocess.run(cmd, cwd=str(repo_dir), text=True, capture_output=True)\n",
