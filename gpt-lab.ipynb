        "    if result.stderr:\n",
        "        print(result.stderr)\n",
        "    if result.returncode != 0:\n",
        "        print(\"\\n아직 통과하지 못한 테스트가 있습니다. 해당 단계의 implementation item를 먼저 구현하세요.\")\n",
        "    else:\n",
        "        print(\"\\n선택한 테스트를 통과했습니다.\")\n",
        "    return result.returncode"
